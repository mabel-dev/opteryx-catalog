+    query = (
+        client.collection_group(TRIGGERS_SUBCOLLECTION)
+        .where(filter=FieldFilter("event-kind", "==", SCHEDULE_EVENT_KIND))
+        .where(filter=FieldFilter("next-due-at-ms", "<=", now_ms))
+    )
+    due = []
+    for doc in query.stream():
